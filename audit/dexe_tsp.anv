// DeXe Protocol Forensic Audit Invariants
// Focus: TokenSaleProposalBuy precision and commission logic

contract TokenSaleProposalBuy {
    state precision: u128 = 10000000000000000000000000; // 10^25

    invariant {
        precision == 10000000000000000000000000
    }

    pub fn get_sale_token_amount(amount: u128, exchange_rate: u128) -> u128
        where {
            amount > 0,
            exchange_rate > 0,
            // Assert that the result is non-zero for reasonable rates
            (amount * 10000000000000000000000000) / exchange_rate > 0
        }
    {
        let res = (amount * 10000000000000000000000000) / exchange_rate;
        assert(res > 0, "DeXe: Zero tokens emitted");
        return res;
    }

    // Monotonicity test: If you pay more, you get more (or same)
    pub fn monotonicity_check(a1: u128, a2: u128, rate: u128) -> u128
        where {
            a1 < a2,
            rate > 0,
            (a1 * 10000000000000000000000000) / rate <= (a2 * 10000000000000000000000000) / rate
        }
    {
        return 0;
    }
}
