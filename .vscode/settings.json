{
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/.cache/**": true,
    "**/target/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/artifacts/**": true,
    "**/services/proof-market/target/**": true,
    "**/human-anomalies/node_modules/**": true,
    "**/human-anomalies/dist/**": true,
    "**/editors/vscode/node_modules/**": true,
    "**/agents-archi-mvp/sdk-ts/node_modules/**": true
  },
  "search.exclude": {
    "**/target": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/artifacts": true,
    "**/services/proof-market/target": true,
    "**/human-anomalies/node_modules": true,
