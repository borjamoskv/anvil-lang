// ============================================================
// ADVERSARIAL EXAMPLE: Integer Overflow Attack
//
// Demonstrates how Anvil catches unsafe arithmetic through
// type-bounded Z3 constraints.
// ============================================================

// UNSAFE: Addition without overflow guard.
// The postcondition demands total' == a + b, but with
// no upper bound on a + b, Z3 can find values where
// the result exceeds u64 range.
fn add_unsafe(mut a: u64, b: u64) -> u64
    where {
        a > 0,
        b > 0,
        a' == a + b
    }
{
    a += b;
    return a;
}

// SAFE: Addition with explicit overflow guard.
// The precondition `a + b <= max_supply` ensures
// the result stays within bounds.
fn add_safe(mut a: u64, b: u64, max_supply: u64) -> u64
    where {
        a > 0,
        b > 0,
        a + b <= max_supply,
        max_supply > 0,
        a' == a + b
    }
{
    a += b;
    return a;
}
