// ============================================================
// EXAMPLE: ERC-4626 Vault with Logical Invariants
// 
// Demonstrates:
// 1. Logical OR (||) in invariant expressions
// 2. Logical AND (&&) in invariant expressions
// 3. Contract-level deposit/withdraw with share tracking
// 4. Intentionally broken withdraw for adversarial testing
// ============================================================

// Deposit: assets in, shares out (1:1 for simplicity)
// The invariant uses || to express: "either nothing exists, or assets back shares"
fn deposit(total_supply: u64, total_assets: u64, amount: u64) -> u64
    where {
        amount > 0,
        total_supply' == total_supply + amount,
        total_assets' == total_assets + amount
    }
{
    total_supply += amount;
    total_assets += amount;
    return total_supply;
}

// Withdraw with combined logical invariant:
// shares > 0 AND supply >= shares AND assets >= shares
fn withdraw(total_supply: u64, total_assets: u64, shares: u64) -> u64
    where {
        shares > 0 && total_supply >= shares && total_assets >= shares,
        total_supply' == total_supply - shares,
        total_assets' == total_assets - shares
    }
{
    total_supply -= shares;
    total_assets -= shares;
    return total_assets;
}

// Invariant with OR: either no shares exist, or assets > 0
// This tests the || operator in invariant expressions
fn check_solvency(total_supply: u64, total_assets: u64) -> u64
    where {
        total_supply == 0 || total_assets > 0,
        total_supply' == total_supply,
        total_assets' == total_assets
    }
{
    return total_assets;
}

// ============================================================
// BROKEN: Withdraw that doesn't update total_supply
// This simulates a share inflation attack.
// Anvil MUST reject this.
// ============================================================

fn withdraw_broken(total_supply: u64, total_assets: u64, shares: u64) -> u64
    where {
        shares > 0 && total_supply >= shares && total_assets >= shares,
        total_supply' == total_supply - shares,
        total_assets' == total_assets - shares
    }
{
    // BUG: only decrement assets, not supply
    total_assets -= shares;
    return total_assets;
}

// ============================================================
// BROKEN: Direct donation + Share Inflation
// This simulates a highly adversarial inflation vector where an
// attacker manipulates total_assets directly, but fails to burn
// shares properly, bypassing simple checks.
// Anvil's global conservation invariant MUST reject this.
// ============================================================

fn donation_inflation(total_supply: u64, total_assets: u64, donation: u64, shares: u64) -> u64
    where {
        donation > 0 && shares > 0 && total_supply >= shares && total_assets + donation >= shares,
        total_supply' == total_supply - shares,
        total_assets' == total_assets + donation - shares
    }
{
    // BUG: Inflation vector: supply is not decremented, assets reflect a donation and a withdraw
    total_assets += donation;
    total_assets -= shares;
    return total_assets;
}
