// ============================================================
// ANVIL FORENSIC HARNESS — Firedancer Funk State Ghosting
// Vulnerability: Stale Record Shadowing via Dirty Read
// Target: fd_funk_txn_publish
// ============================================================

fn ghosting_window_race(
    last_publish_ptr: u256,
    txn_a_records_migrated: bool,
    reader_query_time: u256,
    publish_update_time: u256,
    migration_complete_time: u256,
    stale_read_occurred: bool
) -> bool
where {
    // 1. Cronología Base (Time Topology)
    publish_update_time > 0,
    migration_complete_time > publish_update_time, // Migración ocurre DESPUÉS de actualizar el puntero
    
    // 2. El atacante/lector consulta exactamente en el Ghosting Window
    reader_query_time > publish_update_time,
    reader_query_time < migration_complete_time,

    // 3. Estado del sistema durante la consulta
    last_publish_ptr == 1,              // El puntero dice "mira en el ROOT"
    txn_a_records_migrated == false,    // Pero el ROOT aún no tiene los datos nuevos

    // 4. Mecánica de Lectura Sucia (Dirty Read)
    // Si last_publish == 1 y records_migrated == false, el lector obtiene NULL o datos viejos
    stale_read_occurred == (last_publish_ptr == 1 && txn_a_records_migrated == false),

    // POSTCONDITION (Consensus Strike):
    // Z3 demostrará que existe una ventana temporal donde stale_read_occurred es TRUE,
    // rompiendo la garantía de consistencia de Solana/Firedancer.
    stale_read_occurred' == false
} {
    // Evolución de la máquina de estados
    return stale_read_occurred;
}
