// ============================================================
// ARENA ALLOC — Compile-time Verified Arena Memory Model
// ============================================================

// SAFE: Allocations fit within the 16-byte arena capacity (2 allocations of 8-byte aligned slots).
fn test_alloc_safe(mut arena: Arena<16>) -> u64
    where {
        1 == 1
    }
{
    let p1 = alloc(arena, 42); // 1 byte -> 8-byte aligned slot
    let p2 = alloc(arena, 100); // 1 byte -> 8-byte aligned slot
    return 1;
}

// UNSAFE: Allocations exceed 16-byte capacity (OOM with 3 allocations of 8-byte aligned slots).
fn test_alloc_unsafe(mut arena: Arena<16>) -> u64
    where {
        1 == 1
    }
{
    let p1 = alloc(arena, 42); // 1 byte -> 8-byte aligned slot
    let p2 = alloc(arena, 100); // 1 byte -> 8-byte aligned slot
    let p3 = alloc(arena, 200); // 1 byte -> 8-byte aligned slot (exceeds 16 bytes!)
    return 1;
}
